{
  "name": "mimic-pvp",
  "version": "0.1.0",
  "description": "Minecraft sword PvP bot that fights within vanilla limits and moves like a person",
  "main": "src/index.js",
  "bin": {
    "mimic-pvp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/sim-aim.js && node test/arena-unit.js",
    "botfight": "node test/botfight.js",
    "arena:setup": "node arena/setup.js",
    "arena:play": "node arena/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "flying-squid": "^1.12.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "koffi": "^3.3.2"
  }
}
